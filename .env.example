# Copy this file to .env and fill in your keys:
#   cp .env.example .env
# NEVER commit your actual .env file to Git!

OPENROUTER_API_KEY=sk-or-v1-replace-with-your-key

# Optional: which model to use (default: anthropic/claude-sonnet-5.5)
# OPENROUTER_MODEL=anthropic/claude-sonnet-5.5

# Optional: PostHog analytics (pageviews, clicks, session replay). Public phc_ key, not a secret.
# POSTHOG_KEY=phc_your-project-key
# POSTHOG_HOST=https://us.i.posthog.com

# Optional: per-visitor limit on the AI routes (default: 10 per minute;60 per hour)
# AI_RATE_LIMIT=10 per minute;60 per hour

# Optional: proxies in front of the app on Render (visitor -> Cloudflare -> Render). Leave at 3.
# PROXY_HOPS=3
